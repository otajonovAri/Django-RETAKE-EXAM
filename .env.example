# Bu faylni `.env` nomi bilan nusxalab, qiymatlarni o'zgartiring.
# `.env` git'ga tushmaydi (.gitignore da).

# Ishlab chiqarishda albatta yangi kalit qo'ying:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=django-insecure-faqat-ishlab-chiqish-uchun

# Ishlab chiqarishda: False
DJANGO_DEBUG=True

# Vergul bilan ajratilgan ro'yxat
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# HTTPS orqasida ishlaganda, masalan: https://shaharlar.uz
DJANGO_CSRF_TRUSTED_ORIGINS=

# DEBUG=False bo'lganda: HTTPS majburiy (SSL redirect + HSTS + xavfsiz cookie).
# HTTPS'siz serverga qo'ysangiz, False qiling.
DJANGO_HTTPS_ONLY=True
DJANGO_HSTS_SECONDS=31536000

# nginx / Traefik kabi reverse-proxy orqasida ishlasa True
DJANGO_BEHIND_PROXY=False

# Ma'lumotlar bazasi fayli nomi
DJANGO_DB_NAME=db.sqlite3
